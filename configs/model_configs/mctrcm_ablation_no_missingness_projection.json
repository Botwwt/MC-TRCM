  "auto_tree_head_label_types": ["multiclass"],
  "use_ordered_threshold_ordinal_head": true,
  "shared_token_refiner_type": "none",
  "shared_token_refiner_steps": 0,
  "shared_token_refiner_nograd_steps": 0,
  "task_local_trm_mode": "none",
  "task_local_trm_h_cycles": 0,
  "task_local_trm_l_cycles": 0,
  "conditioning_mode": "dataset_task",
  "film_conditioning_mode": "both"
}
