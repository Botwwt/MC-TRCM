{
  "model_name": "mctrcm_final",
  "token_dim": 64,
  "encoder_hidden_dim": 96,
  "transformer_layers": 2,
  "transformer_heads": 4,
  "transformer_ff_dim": 160,
  "latent_dim": 96,
  "dataset_embedding_dim": 16,
  "task_embedding_dim": 16,
  "concept_dim": 0,
